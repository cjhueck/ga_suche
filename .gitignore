# Source folders (too large for git)
Steiner_GA/
Steiner_GA_pdf/
backups/
# Aber Analytics-Backups sollen ins Git (für Persistenz auf Render)
# WICHTIG: Reihenfolge ist wichtig - zuerst ignorieren, dann Ausnahmen
# !backups/ macht alle Backups sichtbar, dann spezifisch analytics erlauben
!backups/analytics/
!backups/analytics/*.json

# Runtime data (should persist between deployments)
analytics-data.json
query-log.json

# Environment variables (API keys!)
.env
.env.local
.env.production

# Python cache
__pycache__/
*.pyc
*.pyo

# Temporary files
*.tmp
*-with-pagebreaks.json

# PDF caches
Steiner_GA_pdf_cache/
wp-pdf-url-cache.json

# Theme summary cache (deployed für Online-Zugriff)

# Spellcheck dictionaries (downloaded on demand)
dictionaries/

# Wrangler local state (R2 emulator cache)
.wrangler/

# Node modules (if any)
node_modules/

# Temp upload directory
uploads_tmp/

# OS files
.DS_Store
Thumbs.db
