# Source folders (too large for git)
Steiner_GA/
Steiner_GA_pdf/
backups/
# Aber Analytics-Backups sollen ins Git (für Persistenz auf Render)
# WICHTIG: Reihenfolge ist wichtig - zuerst ignorieren, dann Ausnahmen
# !backups/ macht alle Backups sichtbar, dann spezifisch analytics erlauben
!backups/analytics/
!backups/analytics/*.json

# Runtime data (should persist between deployments)
analytics-data.json
query-log.json
timeline-search-cache.json

# Environment variables (API keys!)
.env
.env.local
.env.production

# Python cache
__pycache__/
*.pyc
*.pyo

# Temporary files
*.tmp
*-with-pagebreaks.json

# PDF caches
Steiner_GA_pdf_cache/
wp-pdf-url-cache.json

# Theme summary cache (deployed für Online-Zugriff)

# Spellcheck dictionaries (deployed for online use)

# Wrangler local state (R2 emulator cache)
.wrangler/

# Node modules (if any)
node_modules/

# Temp upload directory
uploads_tmp/

# OS files
.DS_Store
Thumbs.db

# Absatz-Embeddings: Cloudflare Vectorize ist die Online-Quelle.
# Lokale JSON-Files dienen nur als Backup für eine eventuelle Re-Migration
# (s. _migrate_paragraph_embeddings.js). Alle Bände ignorieren — bereits
# getrackte GA001–GA012 bleiben aus historischen Gründen im Repo (per Force-Add
# damals committed), neue Bände werden nicht mehr aufgenommen.
paragraph-embeddings/*.json
!paragraph-embeddings/GA001.json
!paragraph-embeddings/GA002.json
!paragraph-embeddings/GA003.json
!paragraph-embeddings/GA004.json
!paragraph-embeddings/GA005.json
!paragraph-embeddings/GA006.json
!paragraph-embeddings/GA007.json
!paragraph-embeddings/GA008.json
!paragraph-embeddings/GA009.json
!paragraph-embeddings/GA010.json
!paragraph-embeddings/GA011.json
!paragraph-embeddings/GA012.json

# Phase-4-Hintergrund-Runner-Logs (Lauf-Artefakte, kein Code)
_phase4_log.jsonl
_phase4_console.log
